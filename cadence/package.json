{
  "name": "cadence",
  "productName": "Cadence",
  "version": "0.1.0",
  "description": "A minimal, highly customizable desktop music player for your local files and your own streaming servers.",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "music-metadata": "^11.0.0"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "app.cadence.player",
    "productName": "Cadence",
    "files": [
      "main.js",
      "preload.js",
      "lib/**",
      "renderer/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio"
    },
    "directories": {
      "output": "dist"
    },
    "asarUnpack": []
  }
}